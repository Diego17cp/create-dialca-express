{
  "name": "create-dialca-express",
  "version": "0.1.0",
  "description": "CLI to scaffold production-ready Express backend projects",
  "type": "module",
  "bin": {
    "create-dialca-express": "./bin/index.js"
  },
  "main": "./bin/index.js",
  "scripts": {
    "build": "rimraf bin && tsup",
    "dev": "tsx src/index.ts",
    "start": "node bin/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "cli",
    "express",
    "scaffold",
    "backend",
    "generator",
    "typescript",
    "nodejs",
    "javascript",
    "project-generator",
    "hexagonal",
    "clean-architecture",
    "dialcadev"
  ],
  "author": {
    "name": "Dialcadev",
    "url": "https://github.com/Diego17cp"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@clack/prompts": "1.5.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Diego17cp/create-dialca-express"
  },
  "bugs": {
    "url": "https://github.com/Diego17cp/create-dialca-express/issues"
  },
  "homepage": "https://github.com/Diego17cp/create-dialca-express#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
